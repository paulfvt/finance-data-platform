# Image légère des services streaming (producteur et consommateur).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app
COPY requirements-stream.txt .
RUN pip install --no-cache-dir -r requirements-stream.txt

# Le code (src/) est monté en volume par docker-compose, comme pour Airflow.
